# Optional overrides. No chatbot API key is used or required.
# BRAINLESS_HEADLESS=false
# BRAINLESS_PROFILE_DIR=data/browser-profile

# Voice input (disabled unless ASSEMBLYAI_API_KEY is set)
# ASSEMBLYAI_API_KEY=
# ASSEMBLYAI_MODEL=universal-3-5-pro
# VOICE_MODE=push_to_talk
# VOICE_SAMPLE_RATE=16000
# VOICE_LANGUAGE=
# VOICE_IDLE_TIMEOUT=30
# VOICE_MAX_SESSION_DURATION=900
# VOICE_MIN_CONFIDENCE=0.75
# VOICE_SENSITIVE_CONFIDENCE=0.92
# VOICE_RECONNECT_LIMIT=3
# VOICE_STORE_TRANSCRIPTS=false
# VOICE_STORE_AUDIO=false
